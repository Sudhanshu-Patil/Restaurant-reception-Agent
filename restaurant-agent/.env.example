# Copy to .env and fill in GROQ_API_KEY.
# The provided restaurant-api/.env (in the exercise's original zip) ships a
# working key; any Groq key works with the default model.

GROQ_API_KEY=your-groq-api-key
MODEL=openai/gpt-oss-20b
RESTAURANT_API_URL=http://localhost:8000

# --- optional tunables (defaults shown) ---
# REQUEST_TIMEOUT=60
# MAX_AGENT_STEPS=8
# MAX_TOOL_CALLS=12
# MAX_MUTATIONS=6
# AGENT_DB_PATH=data/agent.db
# SESSION_TTL_DAYS=30
